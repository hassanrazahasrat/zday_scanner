# ZDay Scanner - Environment Variables
# Copy to .env and customize (never commit .env to git!)
# All variables prefixed with ZDAY_

# =============================================================================
# NETWORK SETTINGS
# =============================================================================
# ZDAY_TIMEOUT=30                    # Request timeout in seconds
# ZDAY_RATE_LIMIT=10.0              # Requests per second
# ZDAY_MAX_CONCURRENT=10            # Max concurrent requests
# ZDAY_VERIFY_SSL=true              # Verify SSL certificates (true/false)
# ZDAY_FOLLOW_REDIRECTS=true        # Follow HTTP redirects (true/false)
# ZDAY_PROXY=                       # Proxy URL (e.g., http://127.0.0.1:8080)
# ZDAY_MAX_PAGES=100                # Maximum pages to crawl
# ZDAY_CRAWL_DEPTH=2                # Crawl depth
# ZDAY_RESPECT_ROBOTS=true          # Respect robots.txt (true/false)
# ZDAY_USER_AGENT="ZDay Scanner/1.0"

# =============================================================================
# FEATURE TOGGLES
# =============================================================================
# ZDAY_ENABLE_HEADLESS=true         # Enable Playwright-based fingerprinting
# ZDAY_ENABLE_VERSION_DETECTION=true
# ZDAY_ENABLE_CVE_MATCHING=true
# ZDAY_ENABLE_INJECTION=true        # Enable injection tests (SQLi, XSS, etc.)
# ZDAY_ENABLE_DESERIALIZATION=true
# ZDAY_ENABLE_AUTH_BYPASS=true
# ZDAY_ENABLE_LOGIC=true
# ZDAY_ENABLE_RACE=false            # Race condition tests (intrusive)
# ZDAY_ENABLE_CRYPTO=true
# ZDAY_ENABLE_INTRUSIVE=false       # Enable intrusive tests

# =============================================================================
# BROWSER / PLAYWRIGHT SETTINGS
# =============================================================================
# ZDAY_HEADLESS=true                # Run browser headless
# ZDAY_BROWSER_TIMEOUT=30           # Browser timeout in seconds
# ZDAY_BROWSER_WAIT_UNTIL=networkidle  # Wait condition: load, domcontentloaded, networkidle
# ZDAY_ENABLE_STEALTH=true          # Enable stealth mode

# Browser executable path - Options:
#   "auto"        - Auto-detect system Chrome/Chromium/Edge/Brave (default)
#   "/path/to/chrome" - Explicit path to browser executable
#   ""            - Use Playwright's bundled browser
# ZDAY_BROWSER_EXECUTABLE_PATH=auto

# Browser channel (alternative to executable_path):
#   "chrome"      - Google Chrome
#   "msedge"      - Microsoft Edge
#   "chromium"    - Chromium
#   "brave"       - Brave Browser
# ZDAY_BROWSER_CHANNEL=

# Custom browser args (comma-separated)
# ZDAY_BROWSER_ARGS=--disable-web-security,--no-sandbox

# CDP endpoint - Connect to existing browser instance
# ZDAY_CDP_ENDPOINT=http://localhost:9222

# =============================================================================
# REPORTING
# =============================================================================
# ZDAY_MIN_SEVERITY=info            # Minimum severity: debug, info, low, medium, high, critical
# ZDAY_DEBUG=false                  # Enable debug logging

# =============================================================================
# AUTHENTICATION (sensitive - use .env, not config.yaml)
# =============================================================================
# ZDAY_AUTH_HEADERS='{"Authorization": "Bearer <token>"}'
# ZDAY_CUSTOM_HEADERS='{"X-Custom": "value"}'
# ZDAY_CUSTOM_COOKIES='{"sessionid": "abc123"}'